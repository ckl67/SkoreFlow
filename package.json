{
  "name": "skoreflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "testauto/backend"
  ],
  "scripts": {
    "-- 🎼 SKOREFLOW --": "",
    "dev": "concurrently -k -n \"THUMB,BACK,FRONT\" -c \"magenta,blue,cyan\" \"npm:dev:thumbnail\" \"npm:test:backend\" \"npm:dev:frontend\"",
    "vm": "concurrently -k -n \"THUMB,BACK,FRONT\" -c \"magenta,blue,cyan\" \"npm:dev:thumbnail\" \"npm:test:backend\" \"npm:vm:frontend\"",
    "debug": "concurrently -k -n \"THUMB,BACK,FRONT\" -c \"magenta,blue,cyan\" \"npm:dev:thumbnail\" \"npm:test:backend:debug\" \"npm:vm:frontend\"",
    "-- 🐍 MICROSERVICES --": "",
    "dev:thumbnail": "cd microservice/thumbnail && make",
    "-- 🐹🌀 BACKEND DEV --": "",
    "dev:backend": "cd backend && make air-dev",
    "dev:backend:run": "cd backend && make run-dev",
    "dev:backend:debug": "cd backend && make debug-dev",
    "-- 🐹🌀🧪 BACKEND TEST (RegToken)(Seed) --": "",
    "test:backend": "cd backend && make air-test",
    "test:backend:run": "cd backend && make run-test",
    "test:backend:debug": "cd backend && make debug-test ",
    "-- ⚛️🖥️🩺 FRONTEND DEV VM (Debug Panel) --": "",
    "vm:frontend": "npm exec -w frontend -- vite --mode vm.dev",
    "-- ⚛️🩺 FRONTEND DEV LOCAL (Debug Panel)": "",
    "dev:frontend": "npm exec -w frontend -- vite --mode dev",
    "-- 📫 DEV TOOLS --": "",
    "mailpit": "docker start mailpit",
    "-- 🧹 UTILITIES --": "",
    "clean-backend": "cd backend && make cleandb-storage",
    "kill-services": "sudo fuser -k 8080/tcp || true && sudo fuser -k 5001/tcp || true && sudo fuser -k 5173/tcp || true",
    "status-mailpit": "docker ps -a -f name=mailpit",
    "-- 🧑‍🔬 OVERALL TEST --": "",
    "test:e2e-with-ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "-- 🪮 OTHER--": "",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cspell": "cspell"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.4",
    "cspell": "^9.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
