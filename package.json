{
  "name": "skoreflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "testauto/backend"
  ],
  "scripts": {
    "-- 🎼 SKOREFLOW --": "",
    "local": "concurrently -k -n \"THUMB,BACK,FRONT\" -c \"magenta,blue,cyan\" \"npm:thumbnail:dev\" \"npm:backend:dev\" \"npm:frontend:local\"",
    "vm": "concurrently -k -n \"THUMB,BACK,FRONT\" -c \"magenta,blue,cyan\" \"npm:thumbnail:dev\" \"npm:backend:dev\" \"npm:frontend:vm\"",
    "vmm": "npm run thumbnail:dev",
    "vmb": "npm run clean-backend && npm run backend:dev",
    "vmbc": "npm run clean-backend && RESET_DB_STORAGE=1 npm run backend:dev",
    "vmf": "npm run frontend:vm",
    "debug": "concurrently -k -n \"THUMB,BACK,FRONT\" -c \"magenta,blue,cyan\" \"npm:thumbnail:dev\" \"npm:backend:debug\" \"npm:frontend:vm\"",
    "-- 🐍 MICROSERVICES --": "",
    "thumbnail:dev": "cd microservices/thumbnail && make run",
    "-- 🐹🌀🧪 BACKEND --": "",
    "backend:debug": "cd backend && make debug",
    "backend:dev": "cd backend && make air",
    "backend:run": "cd backend && make run",
    "-- ⚛️🖥️🩺 FRONTEND DEV VM (Debug Panel) --": "",
    "frontend:vm": "npm exec -w frontend -- vite --mode vm.dev",
    "-- ⚛️🩺 FRONTEND DEV LOCAL (Debug Panel)": "",
    "frontend:local": "npm exec -w frontend -- vite --mode dev",
    "-- 📫 DEV TOOLS --": "",
    "mailpit": "docker start mailpit",
    "-- 🧹 UTILITIES --": "",
    "clean-backend": "cd backend && make cleandb-storage",
    "cb": "npm run clean-backend",
    "kill-services": "sudo fuser -k 8080/tcp || true && sudo fuser -k 5001/tcp || true && sudo fuser -k 5173/tcp || true",
    "ks": "npm run kill-services",
    "status-mailpit": "docker ps -a -f name=mailpit",
    "-- 🧑‍🔬 OVERALL TEST --": "",
    "test:e2e-with-ui": "playwright test --ui",
    "test:e2e": "playwright test",
    "-- 🪮 OTHER--": "",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cspell": "cspell"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.4",
    "cspell": "^9.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
