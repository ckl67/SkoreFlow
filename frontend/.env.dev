# For dev
# ----------------
# We will not use environement variables (much flexible)
# vite build --mode dev

# Backend address
# Thanks to the Vite proxy `config.js`, there’s no need for an absolute URL here either!
VITE_API_URL=/api/v1

# Will activate the debug panel
VITE_TEST_MODE=true

# Autorize a new user to Register
REGISTER_ALLOWED=false
