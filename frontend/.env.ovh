# For production
# ----------------
# npm run build --> vite build (packages.json)
# We setup via environement variables !

# Backend address
# Frontend hosted on the OVH VPS (Nginx)
# The browser downloads the frontend from address below
#    Browser
#       |
#   http://137.74.168.176
#       |
#       v
#     Nginx
#       |
#       +--> /
#       |
#       +--> /api/v1
#
#   The frontend no longer needs to know the backend’s address thanks to nginx
#   See sudo nano /etc/nginx/sites-available/skoreflow
VITE_API_URL=/api/v1

# Will activate the debug panel
VITE_TEST_MODE=true

# Autorize a new user to Register
REGISTER_ALLOWED=false
