# For production
# ----------------
# npm run build --> vite build (packages.json)
# We setup via environement variables !

# Backend address
# Frontend servi par le VPS (Nginx)
# The browser downloads the frontend from address below
#    Browser
#       |
#   http://137.74.168.176
#       |
#       v
#     Nginx
#       |
#       +--> /
#       |
#       +--> /api
#
#   The frontend no longer needs to know the backend’s address.

VITE_API_URL=/api

# Will activate the debug panel
VITE_TEST_MODE=true
