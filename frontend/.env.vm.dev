# For dev
# ----------------
# We will not use environement variables (much flexible)
# vite build --mode vm.dev

# Backend address
# The browser downloads the frontend from address below
# This is the only place where you use an absolute URL, as the frontend and backend are physically separate on a local
# network and do not share the same localhost.

VITE_API_URL=http://192.168.1.249:8080/api/v1
# VITE_API_URL=http://192.168.38.128:8080/api/v1

# Will activate the debug panel
VITE_TEST_MODE=true

# Autorize a new user to Register
REGISTER_ALLOWED=false
