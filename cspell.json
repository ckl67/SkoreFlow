{
  "version": "0.2",
  "language": "en",
  "files": ["**/*.{js,ts,jsx,tsx,md,json}"],
  "ignorePaths": [
    "node_modules/**",
    ".cspell/custom-dictionary.txt",
    "*.mod",
    "*.dio",
    ".git/**",
    ".vscode/**",
    ".gitignore",
    "**/venv/**",
    "**/.*",
    "docs/draft/**"
  ],
  "dictionaries": ["custom-dictionary"],
  "dictionaryDefinitions": [
    {
      "name": "custom-dictionary",
      "path": ".cspell/custom-dictionary.txt",
      "addWords": true
    }
  ]
}
