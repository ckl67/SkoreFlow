{
  "version": "0.2",
  "language": "en",
  "files": ["**/*.{js,ts,jsx,tsx,md,json,go}"],
  "ignorePaths": [
    "node_modules/**",
    ".git/**",
    ".vscode/**",
    "**/.gitignore",
    "**/venv/**",
    "**/.*",
    "**/package.json"
  ],
  "dictionaries": ["custom-dictionary"],
  "dictionaryDefinitions": [
    {
      "name": "custom-dictionary",
      "path": ".cspell/custom-dictionary.txt",
      "addWords": true
    }
  ]
}
